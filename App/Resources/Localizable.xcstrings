    "push.cancelled.body": {
      "comment": "Body of the cancellation push. %@ is the race name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will not take place."
          }
        },
