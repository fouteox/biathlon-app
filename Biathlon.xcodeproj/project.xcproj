        { "path": "<PRODUCTS>/BiathlonWidgets.appex", "id": "9B9B6B4BEF63DF380CE8B792", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Biathlon/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/BiathlonTests.xctest", "id": "BE124E20951CA509C95A4318", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/BiathlonUITests.xctest", "id": "5E1D0C8A3B7F42D19A6C2E03", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "Biathlon",
      "id": "B929537D5C5472FBEA585959",
      "product": "Products/Biathlon.app",
      "product-type": "application",
      "legacy-provisioning-style": "automatic",
      "specialized-configurations": [
