  "files": [
    { "kind": "folder", "path": "App", "target-membership": [ "Biathlon" ] },
    { "kind": "folder", "path": "Shared", "target-membership": [ "Biathlon", "BiathlonWidgets" ] },
    { "kind": "folder", "path": "Widgets", "target-membership": [ "BiathlonWidgets" ] },
    { "kind": "folder", "path": "BiathlonTests", "target-membership": [ "BiathlonTests" ] },
