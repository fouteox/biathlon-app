{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "biathlon-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Public URL the app registers devices with: https://biathlon-server.fouteox.workers.dev
  "workers_dev": true,
  // Not used: new versions are deployed with `wrangler deploy`, never previewed.
  "preview_urls": false,
  // Every minute: the finest Cron Trigger granularity.
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "biathlon",
      "database_id": "173d1fd8-cacb-4b93-a4de-5fb5ec22a016",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      // Sends the device pushes in lots, each Durable Object invocation having its own subrequests (src/pushSender.ts).
      { "name": "PUSH_SENDER", "class_name": "PushSender" },
      // One per race, named after it, for its Live Activity (src/raceActivity.ts).
      { "name": "RACE_ACTIVITY", "class_name": "RaceActivity" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PushSender"] },
    { "tag": "v2", "new_sqlite_classes": ["RaceActivity"] },
  ],
  // Requests per minute and client IP address, counted in each Cloudflare location (src/index.ts):
  // the IBU API requests the cache can't answer, and the App Attest challenges.
  "ratelimits": [
    { "name": "IBU_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "CHALLENGE_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
  ],
  "vars": {
    "APNS_TOPIC": "com.fouteox.biathlon",
    // Oldest app build (CFBundleVersion) App Attest accepts: raise it to shut out builds before a fix.
    "APP_ATTEST_MIN_BUNDLE_VERSION": "1",
  },
  "secrets": {
    // Apple recommends one team-scoped key per APNs environment.
    // APP_ATTEST_APP_ID: "<App ID prefix>.<bundle ID>". APP_ATTEST_SECRET: random key that signs challenges.
    "required": [
      "APNS_TEAM_ID",
      "APNS_SANDBOX_KEY",
      "APNS_SANDBOX_KEY_ID",
      "APNS_PRODUCTION_KEY",
      "APNS_PRODUCTION_KEY_ID",
      "APP_ATTEST_APP_ID",
      "APP_ATTEST_SECRET",
    ],
  },
}
