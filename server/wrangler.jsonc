{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "biathlon-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Public URL the app registers devices with: https://biathlon-server.fouteox.workers.dev
  "workers_dev": true,
  // Not used: new versions are deployed with `wrangler deploy`, never previewed.
  "preview_urls": false,
  // Every minute: the finest Cron Trigger granularity.
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "biathlon",
      "database_id": "173d1fd8-cacb-4b93-a4de-5fb5ec22a016",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APNS_TOPIC": "com.fouteox.biathlon",
    // Each push is one subrequest; the Free plan allows 50 per invocation.
    "MAX_PUSHES_PER_RUN": "30"
  },
  "secrets": {
    // Apple recommends one team-scoped key per APNs environment.
    // APP_ATTEST_APP_ID: "<App ID prefix>.<bundle ID>". APP_ATTEST_SECRET: random key that signs challenges.
    "required": [
      "APNS_TEAM_ID",
      "APNS_SANDBOX_KEY",
      "APNS_SANDBOX_KEY_ID",
      "APNS_PRODUCTION_KEY",
      "APNS_PRODUCTION_KEY_ID",
      "APP_ATTEST_APP_ID",
      "APP_ATTEST_SECRET"
    ]
  }
}
