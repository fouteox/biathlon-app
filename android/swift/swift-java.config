// jextract's settings for the Java bindings to BiathlonKit.
{
  "javaPackage": "com.fouteox.biathlon.kit",
  "mode": "jni",
  // Trial findings (swift-java 0.7.0): the bindings generated for these do not compile.
  // - FavoriteSet: its two contains(_:) overloads get the same JNI symbol.
  // - ServerClient: its `environment` parameters clash with the thunks' JNI environment.
  // - SeasonStandings (the file, with IBUClient's two worldCupStandings overloads): both
  //   overloads get the same Java helper method.
  // - IBUError: its case with an `any Error` payload gets a Java record that does not match.
  "swiftFilterExclude": ["FavoriteSet", "ServerClient", "SeasonStandings", "IBUError"],
  // SwiftJava is linked statically into libBiathlonKit.so, so there is no libSwiftJava.so to load.
  "overrideStaticBlockLibraryLoading": ["System.loadLibrary(LIB_NAME);"]
}
