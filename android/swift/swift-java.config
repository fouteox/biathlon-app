// jextract's settings for the Java bindings to BiathlonKit.
{
  "javaPackage": "com.fouteox.biathlon.kit",
  "mode": "jni",
  // Trial finding (swift-java 0.7.0): the thunks generated for these types do not compile.
  // FavoriteSet's two contains(_:) overloads get the same JNI symbol, and ServerClient's
  // `environment` parameters clash with the thunks' own JNI environment parameter.
  "swiftFilterExclude": ["FavoriteSet", "ServerClient"]
}
