    "push.cancelled.body": {
      "comment": "Body of the cancellation push. %@ is the race name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will not take place."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'aura pas lieu."
          }
        }
      }
    },
    "push.cancelled.title": {
      "comment": "Title of the push alert sent by the server when a race is cancelled.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Race cancelled"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Course annulée"
          }
        }
      }
    },
    "push.liveActivity.body": {
      "comment": "Body of the alert of a Live Activity the server starts for a favorite. %@ is the race name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow %@ live on the Lock Screen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez %@ en direct sur l'écran verrouillé."
          }
        }
      }
    },
    "push.liveActivity.title": {
      "comment": "Title of the alert of a Live Activity the server starts because a favorite is on the start list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A favorite is racing"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un favori est au départ"
          }
        }
      }
    },
    "push.rescheduled.body": {
      "comment": "Body of the start time push. First %@ is the race name, second the new start time.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ now starts at %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : nouveau départ à %@."
          }
        }
      }
    },
    "push.rescheduled.title": {
      "comment": "Title of the push alert sent by the server when a start time moves.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start time changed"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Horaire modifié"
          }
        }
      }
    }
