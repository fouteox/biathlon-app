// Settings of the Biathlon app target.

PRODUCT_BUNDLE_IDENTIFIER = com.fouteox.biathlon
TARGETED_DEVICE_FAMILY = 1
CODE_SIGN_STYLE = Automatic
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

INFOPLIST_FILE = Configs/Info.plist
CODE_SIGN_ENTITLEMENTS = Configs/Biathlon.entitlements

// Privacy policy page, linked from Settings > About and in App Store Connect (App Review 5.1.1).
// The link stays hidden while empty. The double slash is escaped: xcconfig files treat //
// as the start of a comment.
BIATHLON_PRIVACY_POLICY_URL =
