// Settings shared by every target and configuration.

// Apple Developer team ID (Membership details), used for automatic signing.
DEVELOPMENT_TEAM = G9BR433264

IPHONEOS_DEPLOYMENT_TARGET = 26.0
MARKETING_VERSION = 1.0.0
// Xcode Cloud replaces it with its own build number.
CURRENT_PROJECT_VERSION = 1

// Swift 6 language mode: complete data-race checking is implied.
SWIFT_VERSION = 6.0
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_UPCOMING_FEATURE_EXISTENTIAL_ANY = YES
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES

// String Catalogs: the compiler extracts localizable strings into Shared/Localizable.xcstrings.
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
SWIFT_EMIT_LOC_STRINGS = YES

// Cloudflare Worker base URL (see server/README.md), read by the app and its widget; push
// alerts stay off while empty. The double slash is escaped: xcconfig files treat // as the
// start of a comment.
BIATHLON_SERVER_URL = https:/$()/biathlon-server.fouteox.workers.dev
