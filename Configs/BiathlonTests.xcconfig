// Settings of the BiathlonTests target: the app's unit tests, hosted by the app.

PRODUCT_BUNDLE_IDENTIFIER = com.fouteox.biathlon.tests
TARGETED_DEVICE_FAMILY = 1
CODE_SIGN_STYLE = Automatic
GENERATE_INFOPLIST_FILE = YES

TEST_HOST = $(BUILT_PRODUCTS_DIR)/Biathlon.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/Biathlon
BUNDLE_LOADER = $(TEST_HOST)
